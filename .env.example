# Example environment file for the agent-skills dev tooling.
#
# Copy this to `.env.local` and fill in the values:
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored and is loaded automatically by the e2e harness
# (vitest.e2e.config.ts) and the caveman script (scripts/caveman.ts).
# Variables already set in your shell take precedence over this file.

# ── e2e harness (required to run `npm run test:e2e`) ─────────────────────────

# Comma-separated emails of the test account pool. Multiple accounts spread
# session rate limits across them.
TEST_DATOCMS_ACCOUNT_EMAIL=you@example.com

# Shared password for the test account pool above.
TEST_DATOCMS_ACCOUNT_PASSWORD=

# Organization under which each fresh test project is created.
TEST_DATOCMS_ORGANIZATION_ID=

# ── caveman compression (scripts/caveman.ts) ────────────────────────────────

# Leave UNSET to use your Claude Code subscription (the default). caveman spawns
# the `claude` CLI and inherits this environment, so a declared ANTHROPIC_API_KEY
# forces API-key billing and OVERRIDES your subscription login. Only uncomment it
# if you specifically want pay-as-you-go API billing (e.g. CI with no interactive
# `claude` login). caveman always runs on the `sonnet` model either way.
# ANTHROPIC_API_KEY=

# ── e2e optional toggles ────────────────────────────────────────────────────
# These usually live on the command line (e.g. `E2E_AGENT=opencode npm run
# test:e2e`), but can be set here too. Defaults are shown; uncomment to change.

# Which agent CLI to drive: "claude" (default) or "opencode".
# E2E_AGENT=claude

# Override the model for all cases (per-case `model` still wins).
# E2E_MODEL=claude-opus-4-6

# Override the opencode model (provider/model form).
# E2E_OPENCODE_MODEL=

# Set to 1 to keep test projects instead of tearing them down (debugging).
# E2E_KEEP_PROJECT=1

# Max age (ms) before the pre-run hook cleans up orphaned test projects.
# E2E_CLEANUP_MAX_AGE_MS=1800000

# Set to 1 to force a full wipe of all leftover test projects on the next run.
# E2E_CLEANUP_FORCE=1
