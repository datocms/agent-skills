{
  "name": "agent-skills-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dev-only tooling for the DatoCMS agent skills repo (e2e harness, tests, formatting, release scripts). Kept out of the repo root so plugin installs do not install these dependencies.",
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/*.test.cjs tests/structured-text/convert.test.mjs evals/coexistence/*.test.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coexistence:fixtures": "node --test evals/coexistence/*.test.mjs",
    "eval:coexistence": "cd .. && node dev/evals/coexistence/run.mjs",
    "typecheck": "tsc --noEmit",
    "format": "cd .. && remark . --rc-path dev/remark.config.mjs --no-config --output --quiet",
    "format:check": "cd .. && remark . --rc-path dev/remark.config.mjs --no-config --frail --quiet",
    "bump": "tsx scripts/bump-version.ts",
    "bump:patch": "tsx scripts/bump-version.ts patch",
    "bump:minor": "tsx scripts/bump-version.ts minor",
    "bump:major": "tsx scripts/bump-version.ts major",
    "prepare": "cd .. && husky",
    "test:e2e:harness": "node --test tests/native-e2e.test.mjs tests/catalog-replay.test.mjs tests/deployed-scope.test.mjs tests/visual-harness.test.mjs",
    "e2e:frontend": "cd .. && node dev/e2e/frontend/run.mjs",
    "e2e:hosted": "cd .. && node dev/e2e/hosted/run.mjs",
    "e2e:code": "cd .. && node dev/e2e/workflows/code.mjs",
    "e2e:workflows": "cd .. && node dev/e2e/workflows/run.mjs",
    "e2e:catalog:plugin": "cd .. && node dev/e2e/catalog/plugin.mjs",
    "e2e:catalog:live": "cd .. && tsx dev/e2e/catalog/live.mjs",
    "e2e:deployed": "cd .. && tsx dev/e2e/deployed/actor.mjs",
    "e2e:regressions": "cd .. && node dev/e2e/regressions/run.mjs"
  },
  "devDependencies": {
    "@datocms/cma-client-node": "^6.1.0",
    "@datocms/dashboard-client": "^6.1.0",
    "@types/node": "^22.19.17",
    "datocms": "^4.0.26",
    "datocms-structured-text-dastdown": "6.0.0",
    "datocms-structured-text-utils": "6.0.1",
    "dotenv": "^16.4.5",
    "esbuild": "0.27.7",
    "gpt-tokenizer": "^3.4.0",
    "husky": "^9.1.7",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "unist-util-visit": "^5.1.0",
    "vitest": "^2.1.0"
  }
}
