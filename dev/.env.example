# Example environment file for the agent-skills dev tooling.
#
# Copy this to `dev/.env` (or `dev/.env.local`) and fill in the values:
#
#   cp dev/.env.example dev/.env
#
# Both `.env` and `.env.local` are git-ignored and loaded automatically by the
# e2e harness (dev/vitest.e2e.config.ts) and the caveman script (dev/scripts/caveman.ts).
# Your shell environment always takes precedence over these files.

# ── e2e harness (`npm --prefix dev run test:e2e`) ─────────────────────────────

# Supported route: a dedicated, disposable project with an empty primary
# environment. Each case forks its own `e2e-…` sandbox and removes only that
# sandbox. Prefer supplying the token from your shell or a secret manager.
E2E_DATOCMS_API_TOKEN=
E2E_DATOCMS_SITE_ID=

# Legacy dashboard route (used only when E2E_DATOCMS_API_TOKEN is unset): creates
# a new project per case and never deletes it — remove those projects yourself.
# TEST_DATOCMS_ACCOUNT_EMAIL=you@example.com
# TEST_DATOCMS_ACCOUNT_PASSWORD=
# TEST_DATOCMS_ORGANIZATION_ID=

# ── caveman compression (dev/scripts/caveman.ts) ────────────────────────────────

# Leave UNSET to use your Claude Code subscription (the default). caveman spawns
# the `claude` CLI and inherits this environment, so a declared ANTHROPIC_API_KEY
# forces API-key billing and OVERRIDES your subscription login. Only uncomment it
# if you specifically want pay-as-you-go API billing (e.g. CI with no interactive
# `claude` login). caveman always runs on the `sonnet` model either way.
# ANTHROPIC_API_KEY=

# ── e2e optional toggles ────────────────────────────────────────────────────
# These usually live on the command line (e.g. `E2E_AGENT=opencode npm run
# test:e2e`), but can be set here too. Defaults are shown; uncomment to change.

# Which agent CLI to drive: "codex" (default), "claude" or "opencode".
# E2E_AGENT=codex

# Override the model for all cases (per-case `model` still wins).
# E2E_MODEL=claude-opus-4-6

# Override the opencode model (provider/model form).
# E2E_OPENCODE_MODEL=

# Set to 1 to keep each case's sandbox environment instead of removing it (debugging).
# E2E_KEEP_PROJECT=1
